---
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const pathname = Astro.url.pathname;
const isWriting = pathname === "/" || pathname.startsWith("/blog");
const isAbout = pathname.startsWith("/about");
---

<header class="font-sans">
  <nav class="mx-auto flex max-w-screen-md items-center justify-between px-5 py-4 max-sm:px-5 max-sm:py-3">
    <Link
      href="/"
      underline={false}
      class="text-sm font-extrabold tracking-[0.01em] text-stone-900 dark:text-stone-50"
    >
      {SITE.NAME}
    </Link>

    <div class="flex items-center gap-6">
      <Link
        href="/"
        underline={false}
        class:list={[
          "text-sm",
          isWriting
            ? "font-medium text-stone-900 dark:text-stone-50"
            : "text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-50",
        ]}
      >
          Writing
      </Link>
      <Link
        href="/about"
        underline={false}
        class:list={[
          "text-sm",
          isAbout
            ? "font-medium text-stone-900 dark:text-stone-50"
            : "text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-50",
        ]}
      >
        About
      </Link>
    </div>
  </nav>
</header>
