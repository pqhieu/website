---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <article class="space-y-4 text-secondary">
          <p class="animate">
            Hey there 👋, welcome to my website.
          </p>
          <p>
            I use this space to capture (half-baked) thoughts, explore ideas, and write about things I find interesting.
          </p>
          <p>
            If there's anything you'd like to discuss, please feel free to send me an email.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="text-sm uppercase font-extrabold tracking-[0.1em] text-label">
            Posts
          </h2>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 text-label transition-colors hover:text-black dark:hover:text-white"
            aria-label="RSS"
            title="RSS"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-3.5"
              aria-hidden="true"
            >
              <circle cx="6" cy="18" r="2.2" />
              <path d="M4 10.5v3a6.5 6.5 0 0 1 6.5 6.5h3A9.5 9.5 0 0 0 4 10.5Z" />
              <path d="M4 4v3a13 13 0 0 1 13 13h3C20 11.16 12.84 4 4 4Z" />
            </svg>
            <span class="text-xs uppercase font-extrabold tracking-[0.1em]">RSS</span>
          </a>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
