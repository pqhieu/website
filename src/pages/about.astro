---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";

const ABOUT = {
  TITLE: "About",
  DESCRIPTION: "About Astro Nano.",
};
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-8">
      <h1 class="animate text-2xl font-semibold text-black dark:text-white">
        About
      </h1>

      <article class="space-y-4">
        <p class="animate">
          Astro Nano is a minimal, SEO friendly, accessible portfolio and blog for developers.
        </p>
        <p class="animate">
          It is built with full type safety, RSS and sitemap support, Markdown and MDX content, and Tailwind styling.
        </p>
        <p class="animate">
          The site also supports light, dark, and system theme preferences out of the box.
        </p>
      </article>
    </div>
  </Container>
</PageLayout>
