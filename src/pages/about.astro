---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { dateRange } from "@lib/utils";
import { ABOUT } from "@consts";

const collection = (await getCollection("work"))
  .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const publications = (await getCollection("research"))
  .sort((a, b) => b.data.year - a.data.year);

const staticImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/research/**/static.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true }
);

const hoverImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/research/**/hover.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true }
);

const publicationsWithImages = publications.map((entry) => {
  const staticImage = staticImages[`/src/content/research/${entry.slug}/static.jpg`]
    ?? staticImages[`/src/content/research/${entry.slug}/static.jpeg`]
    ?? staticImages[`/src/content/research/${entry.slug}/static.png`]
    ?? staticImages[`/src/content/research/${entry.slug}/static.webp`]
    ?? staticImages[`/src/content/research/${entry.slug}/static.avif`]
    ?? staticImages[`/src/content/research/${entry.slug}/static.gif`];
  const hoverImage = hoverImages[`/src/content/research/${entry.slug}/hover.jpg`]
    ?? hoverImages[`/src/content/research/${entry.slug}/hover.jpeg`]
    ?? hoverImages[`/src/content/research/${entry.slug}/hover.png`]
    ?? hoverImages[`/src/content/research/${entry.slug}/hover.webp`]
    ?? hoverImages[`/src/content/research/${entry.slug}/hover.avif`]
    ?? hoverImages[`/src/content/research/${entry.slug}/hover.gif`]
    ?? staticImage;

  return {
    ...entry,
    staticImage: staticImage?.default,
    hoverImage: hoverImage?.default,
  };
});
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <article class="space-y-16">
      <section class="prose dark:prose-invert prose-img:mx-auto prose-img:my-auto space-y-4 text-secondary">
        <p>
          My work lies at the intersection of deep learning, computer vision, and robotics.
          More details can be found in <a href="/resume.pdf">my CV</a>.
        </p>
      </section>
      <section>
        <h2 class="mb-6 pb-3 text-sm font-extrabold uppercase tracking-[0.1em] border-b border-black/15 dark:border-white/15 text-label">
          Work
        </h2>
        <ul class="flex flex-col space-y-6">
          {
            work.map(entry => (
              <il class="animate">
                <div class="flex items-baseline justify-between gap-4">
                  <div class="font-semibold text-primary">
                    {entry.data.role}
                  </div>
                  <div class="text-sm text-right text-tertiary">
                    {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                  </div>
                </div>
                <div class="text-sm text-secondary">
                  <span>{entry.data.company}</span>
                  &bull;
                  <span>{entry.data.location}</span>
                </div>
                <div class="mt-4 prose dark:prose-invert prose-img:mx-auto prose-img:my-auto">
                  <entry.Content />
                </div>
              </il>
            ))
          }
        </ul>
      </section>
      <section>
        <h2 class="mb-6 pb-3 text-sm font-extrabold uppercase tracking-[0.1em] border-b border-black/15 dark:border-white/15 text-label">
          Selected Publications
        </h2>
        <div class="flex flex-col space-y-6">
          {
            publicationsWithImages.map(entry => (
              <div class="animate publication-card">
                <div class="publication-media">
                  {entry.staticImage && (
                    <img
                      src={entry.staticImage.src}
                      width={entry.staticImage.width}
                      height={entry.staticImage.height}
                      alt=""
                      loading="lazy"
                      class="publication-media-image publication-media-image-static"
                    />
                  )}
                  {entry.hoverImage && (
                    <img
                      src={entry.hoverImage.src}
                      width={entry.hoverImage.width}
                      height={entry.hoverImage.height}
                      alt=""
                      loading="lazy"
                      class="publication-media-image publication-media-image-hover"
                    />
                  )}
                </div>
                <div class="publication-content min-w-0 space-y-1.5">
                  <p class="m-0 font-semibold leading-snug text-primary">
                    {entry.data.title}
                  </p>
                  <p class="m-0 text-sm leading-relaxed text-secondary">
                    {entry.data.authors}
                  </p>
                  <p class="m-0 text-sm italic text-tertiary">
                    In {entry.data.venue}, {entry.data.year}.
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </article>
  </Container>
</PageLayout>
